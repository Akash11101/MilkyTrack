<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup (to the user's Google Drive, <=25 MB): keep the WebView
     storage (localStorage/IndexedDB) and Capacitor Preferences. -->
<full-backup-content>
    <include domain="sharedpref" path="."/>
    <include domain="root" path="app_webview"/>
    <exclude domain="root" path="app_webview/Default/Cache"/>
    <exclude domain="root" path="app_webview/Default/Code Cache"/>
    <exclude domain="root" path="app_webview/Default/GPUCache"/>
</full-backup-content>
